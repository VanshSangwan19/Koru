# --- Server environment ---

# Port the backend runs on
PORT=5000

# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/koru
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/koru?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/koru

# Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Admin credentials. The admin user is created automatically on first seed.
ADMIN_EMAIL=admin@koru.dev
ADMIN_PASSWORD=ChangeMe123!

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# JWT expiry
JWT_EXPIRES_IN=7d

# Email notifications (optional — leave empty if not configured)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# CONTACT_NOTIFY_EMAIL=
